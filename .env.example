# MATRIX runtime configuration (copy to .env and edit). NEVER commit .env.
# All settings are optional; MATRIX runs local-first with safe defaults.

# ---- service ----
MATRIX_HOST=127.0.0.1
MATRIX_PORT=8765
# Owner API token. If unset, MATRIX generates one into <MATRIX_HOME>/owner_token.txt
# MATRIX_OWNER_TOKEN=replace-with-a-long-random-string

# Where MATRIX keeps its SQLite database, workspace and generated secrets.
# Defaults to %LOCALAPPDATA%\MATRIX on Windows and ~/.matrix elsewhere.
# MATRIX_HOME=C:\Users\you\AppData\Local\MATRIX

# ---- local model runtime (optional; MATRIX degrades honestly without it) ----
# one of: ollama | openai | none
MATRIX_MODEL_PROVIDER=none
MATRIX_MODEL_NAME=qwen2.5:0.5b-instruct-q4_K_M
MATRIX_OLLAMA_URL=http://127.0.0.1:11434
# Any OpenAI-compatible local server (llama.cpp, LM Studio, vLLM).
# MATRIX_OPENAI_BASE_URL=http://127.0.0.1:8080/v1
# MATRIX_OPENAI_API_KEY=local-no-key-required
# Cloud is opt-in only. Leave unset to guarantee nothing leaves the device.
# MATRIX_ALLOW_CLOUD_MODELS=false

# RAM budget (MB) reserved for the model runtime. 8 GB PCs should stay <= 2500.
MATRIX_MODEL_RAM_BUDGET_MB=2500
# Shared local model requests are serialized by default; increase only if the host can handle it.
MATRIX_MODEL_MAX_CONCURRENT_REQUESTS=1
# 283 specialist instances; only selected workers run per task, up to this concurrency cap.
MATRIX_AGENT_MAX_CONCURRENT_WORKERS=4
MATRIX_AGENT_WORKER_TIMEOUT_SECONDS=90

# ---- storage & filesystem scopes ----
# Only these roots are readable/writable by file tools. Semicolon separated.
# MATRIX_FILE_ROOTS=%USERPROFILE%\MATRIX_Workspace
# Allowlisted applications (JSON map of app_id -> executable).
# MATRIX_ALLOWED_APPS={"notepad":"notepad.exe","calculator":"calc.exe"}

# ---- safety ----
MATRIX_AUTONOMY_LEVEL=2
MATRIX_APPROVAL_TTL_SECONDS=300
MATRIX_RATE_LIMIT_PER_MINUTE=240
MATRIX_ALLOW_WEB_FETCH=true
MATRIX_ALLOW_CLOUD_MODELS=false

# ---- optional integrations (never required for core features) ----
# YouTube channel actions: create a Desktop OAuth client in Google Cloud, enable YouTube Data API v3,
# then set MATRIX_YOUTUBE_CLIENT_SECRETS to the downloaded client JSON and run `matrix youtube-auth`.
# The refresh token is stored in the operating-system credential manager, not a plaintext file.
# MATRIX_YOUTUBE_CLIENT_SECRETS=C:\\Users\\you\\Downloads\\client_secret.json
# MATRIX_EXTRA_SCOPES=youtube.write;youtube.upload;github.write
# MATRIX_YOUTUBE_MAX_UPLOAD_BYTES=2000000000
# MATRIX_GITHUB_TOKEN=
#
# LinkedIn: create a LinkedIn developer app with w_member_social access.
# MATRIX_LINKEDIN_ACCESS_TOKEN=
# MATRIX_LINKEDIN_AUTHOR_URN=urn:li:person:YOUR_MEMBER_ID
# MATRIX_LINKEDIN_API_VERSION=202609
#
# Instagram: requires a Professional (Business/Creator) account linked to a Facebook Page
# and an access token with instagram_manage_comments permission.
# MATRIX_INSTAGRAM_ACCESS_TOKEN=
# WhatsApp Cloud API: requires a Meta app, business phone number ID and approved access token.
# MATRIX_WHATSAPP_ACCESS_TOKEN=
# MATRIX_WHATSAPP_PHONE_NUMBER_ID=
# Set a currently supported Graph API version from your Meta app configuration.
# MATRIX_META_GRAPH_VERSION=
# Telegram two-way chat: create a bot with @BotFather, then set its token here.
# Set CHAT_ID to your numeric Telegram user/chat ID (private chat only).
# The bot uses outbound long polling; no public webhook or inbound port is opened.
# MATRIX_TELEGRAM_BOT_TOKEN=123456:replace-with-botfather-token
# MATRIX_TELEGRAM_CHAT_ID=123456789
# MATRIX_HOME_ASSISTANT_URL=
# MATRIX_HOME_ASSISTANT_TOKEN=


# ---- optional local voice engines ----
# Install with: pip install -e ".[voice]"
MATRIX_STT_MODEL=tiny
MATRIX_STT_DEVICE=cpu
MATRIX_STT_COMPUTE_TYPE=int8
# Download a Piper .onnx voice + matching .onnx.json file separately.
# MATRIX_PIPER_MODEL=C:\\MATRIX\\voices\\en_US-lessac-medium.onnx
# MATRIX_PIPER_BIN=piper
